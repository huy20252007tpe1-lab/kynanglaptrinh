#include <iostream>
using namespace std;
void input(int& n, int& k) {
	do {
		cout << "Nhap so luong phan tu (n >= 10): ";
		cin >> n;
	} while (n < 10);
	cout << "Nhap so k: ";
	cin >> k;
}
void listPairsWithSum(int* a, int n, int k) {
	for (int i = 0; i < n; i++) {
		for (int j = i + 1; j < n; j++) {
			if (a[i] + a[j] == k) {
				cout << "(" << a[i] << ", " << a[j] << ")" << endl;
			}
		}
	}
}
//Liệt kê các số cặp nguyên tố cùng nhau trong mảng

int main()
{
	int n;
	int k;
	input(n, k);
	int* a = new int[n];
	listPairsWithSum(a, n, k);

    delete[] a;

    return 0;
}