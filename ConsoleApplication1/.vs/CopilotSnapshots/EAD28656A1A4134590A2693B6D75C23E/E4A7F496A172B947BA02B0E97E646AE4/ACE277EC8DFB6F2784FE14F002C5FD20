#include <iostream>
using namespace std;
void input(int& n, int& k) {
	do {
		cout << "Nhap so luong phan tu (n >= 10): ";
		cin >> n;
	} while (n < 10);
	cout << "Nhap so k: ";
	cin >> k;
}
void listPairsWithSumK(int* a, int n, int k) {
	for (int i = 0; i < n; i++) {
		for (int j = i + 1; j < n; j++) {
			if (a[i] + a[j] == k) {
				cout << "(" << a[i] << ", " << a[j] << ")" << endl;
			}
		}
	}
}
void inputArray(int* a, int n) {
	for (int i = 0; i < n; i++) {
		cout << "Nhap phan tu thu " << i + 1 << ": ";
		cin >> a[i];
	}
}

int gcd(int a, int b) {
	if (a < 0) a = -a;
	if (b < 0) b = -b;
	while (b != 0) {
		int t = a % b;
		a = b;
		b = t;
	}
	return a;
}

void listCoprimePairs(int* a, int n) {
	for (int i = 0; i < n; i++) {
		for (int j = i + 1; j < n; j++) {
			if (gcd(a[i], a[j]) == 1) {
				cout << "(" << a[i] << ", " << a[j] << ")" << endl;
			}
		}
	}
}
//Liệt kê các số cặp nguyên tố cùng nhau trong mảng

int main()
{
	int n;
	int k;
	input(n, k);
	int* a = new int[n];
	inputArray(a, n);
	listPairsWithSumK(a, n, k);

    delete[] a;

    return 0;
}